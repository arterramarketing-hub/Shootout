{
  "name": "shootout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first tactical FPS. Grounded gunplay, COD-Mobile-style presentation.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs --external:ws",
    "server": "npm run build:server && node dist-server/server.mjs",
    "play": "concurrently --kill-others --names server,site --prefix-colors cyan,magenta \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@babylonjs/core": "^9.26.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
